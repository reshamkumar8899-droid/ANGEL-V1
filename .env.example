## ── AI Backend ──────────────────────────────────────
## Set LLM_BACKEND to choose your AI provider:
##   gemini  = Google Gemini (default, free key from https://aistudio.google.com/app/apikey)
##   openai  = Any OpenAI-compatible API (FreeLLMAPI, LM Studio, Ollama, etc.)
LLM_BACKEND=openai

## ── Gemini settings (when LLM_BACKEND=gemini) ──────
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.5-flash-lite

## ── OpenAI-compatible settings (when LLM_BACKEND=openai) ──
OPENAI_BASE_URL=http://127.0.0.1:31415/v1
OPENAI_API_KEY=your_freellmapi_key_here
OPENAI_MODEL=gpt-4o-mini
